# ========================================================
# TEMPLATE KONFIGURASI WEB FISIKA GLB (BACKEND & FRONTEND)
# Copy file ini menjadi .env: cp .env.example .env
# ========================================================

# --- BACKEND SERVER (Elysia.js + SQLite) ---
PORT=3000
HOST=0.0.0.0
DB_PATH=server/fisika.db
CORS_ORIGIN=*

# --- FRONTEND CLIENT (Vite + React) ---
# Alamat URL Backend API yang dipanggil oleh Frontend
# Biarkan http://localhost:3000 untuk dev lokal, atau ubah ke IP/Domain server Anda
VITE_API_BASE_URL=http://localhost:3000
VITE_PORT=5173
VITE_APP_TITLE=SIMULATOR FISIKA GLB
